<Project>
  <!--
    Shared settings for the probes. Each library pins its own ONNX Runtime
    (SK 1.23.2, ElBruno 1.24.4, LMSupply 1.30.0), so each is a standalone console
    project with no solution file, and they are never restored together.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- .NET default (ICU globalization). Run with -p:InvariantGlobalization=true for the
         configuration common in container images; its results are in results/invariant-globalization/. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
